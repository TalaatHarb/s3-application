<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainContainer" prefHeight="720.0" prefWidth="1180.0" styleClass="app-shell" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.talaatharb.s3.ui.controllers.MainUiController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
               <menus>
                  <Menu mnemonicParsing="false" text="File">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onRefresh" text="Refresh" />
                        <MenuItem mnemonicParsing="false" onAction="#onCreateFolder" text="Create Folder" />
                        <MenuItem mnemonicParsing="false" onAction="#onDeleteSelection" text="Delete Selected" />
                        <SeparatorMenuItem />
                        <MenuItem mnemonicParsing="false" onAction="#onCloseApplication" text="Close" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Connections">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAddConnection" text="Add" />
                        <MenuItem mnemonicParsing="false" onAction="#onDeleteConnection" text="Remove Selected" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Help">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onShowAboutDialog" text="About" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <VBox styleClass="hero-panel">
               <children>
                  <Label styleClass="hero-title" text="S3 Browser" />
                  <Label styleClass="hero-subtitle" text="Browse S3-compatible storage like a desktop file manager." />
               </children>
               <padding>
                  <Insets bottom="16.0" left="20.0" right="20.0" top="18.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.28" BorderPane.alignment="CENTER">
         <items>
            <VBox spacing="12.0" styleClass="side-panel">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label styleClass="panel-title" text="Connections" />
                     </children>
                  </HBox>
                  <ComboBox fx:id="configCombo" onAction="#onConfigSelected" promptText="Select connection profile" />
                  <Separator />
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label styleClass="panel-title" text="Buckets" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="newBucketButton" mnemonicParsing="false" onAction="#onCreateBucket" styleClass="icon-button" text="＋" />
                        <Button fx:id="deleteBucketButton" mnemonicParsing="false" onAction="#onDeleteBucket" styleClass="icon-button danger-button" text="－" />
                     </children>
                  </HBox>
                  <ListView fx:id="bucketListView" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </VBox>
            <VBox spacing="14.0" styleClass="content-panel">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="browser-toolbar">
                     <children>
                        <Label styleClass="toolbar-title" text="Bucket" />
                        <Label fx:id="currentBucketLabel" styleClass="toolbar-value" text="No bucket selected" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="upButton" mnemonicParsing="false" onAction="#onNavigateUp" text="Up" />
                        <Button mnemonicParsing="false" onAction="#onRefresh" text="Refresh" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="breadcrumb-bar">
                     <children>
                        <Label styleClass="panel-title" text="Path" />
                        <Label fx:id="pathLabel" styleClass="path-label" text="/" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="bucketStatsLabel" styleClass="stats-label" text="Bucket: 0 items" />
                        <Label fx:id="currentFolderStatsLabel" styleClass="stats-label" text="Here: 0 items" />
                     </children>
                  </HBox>
                  <ToolBar styleClass="action-toolbar">
                     <items>
                        <Button fx:id="downloadButton" mnemonicParsing="false" onAction="#onDownloadObject" text="Download" />
                        <Button fx:id="uploadFileButton" mnemonicParsing="false" onAction="#onUploadFile" text="Upload File" />
                        <Button fx:id="uploadFolderButton" mnemonicParsing="false" onAction="#onUploadFolder" text="Upload Folder" />
                        <Button fx:id="newFolderButton" mnemonicParsing="false" onAction="#onCreateFolder" text="New Folder" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#onDeleteSelection" text="Delete" />
                     </items>
                  </ToolBar>
                  <Label fx:id="selectionInfoLabel" styleClass="selection-label" text="Select a bucket and browse folders like a file manager." />
                  <ListView fx:id="objectListView" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
   </center>
   <bottom>
      <VBox spacing="8.0" styleClass="bottom-panel" BorderPane.alignment="CENTER">
         <children>
            <TabPane prefHeight="210.0" tabClosingPolicy="UNAVAILABLE">
               <tabs>
                  <Tab text="Tasks">
                     <content>
                        <AnchorPane>
                           <children>
                              <VBox fx:id="tasksVbox" spacing="8.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <padding>
                                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
                  <Tab text="Activity">
                     <content>
                        <ListView fx:id="activityLogListView" />
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
               <children>
                  <Label styleClass="status-caption" text="Status" />
                  <Label fx:id="statusLabel" styleClass="status-value" text="Ready." />
               </children>
               <padding>
                  <Insets bottom="10.0" left="16.0" right="16.0" top="0.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>